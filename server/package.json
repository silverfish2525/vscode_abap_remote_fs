  "license": "MIT",
  "dependencies": {
    "abap-adt-api": "^8.4.0",
    "abapcdsgrammar": "0.0.7",
    "antlr4ts": "0.5.0-alpha.4",
    "html-entities": "^2.3.3",
    "lodash": "^4.17.21",
    "vscode-abap-remote-fs-sharedapi": "workspace:*",
    "vscode-languageserver": "^10.0.0",
